<?xml version="1.0"?>
<!--
  NASA Lunabotics 2026-2027 Artemis Arena navigation world.

  Coordinates match Figure 9: the southwest arena-wall corner is (0, 0),
  +x points toward the berm end, +y crosses the arena, and z=0 is the
  nominal BP-1 surface.

  Guidebook geometry:
    arena footprint       6.88 m x 5.00 m (prose rounds length to 6.8 m)
    excavation-zone width 2.50 m
    target berm area      2.20 m x 0.90 m
    target berm center    (5.38 m, 0.90 m)
    perimeter duct OD     0.17 m
    BP-1 depth            0.45 m
    rocks                 0.30-0.40 m diameter, minimum three
    craters               <= 0.40-0.50 m width/depth, minimum three

  Assumptions where the guidebook has no dimension:
    wall height / thickness 0.60 m / 0.10 m
    central column          0.45 m square, centered in the arena
    obstacle poses          fixed for repeatable testing

  The BP-1 bed is a static traction surface. Craters are low, dark collision
  proxies for perception and path-planning tests. This world does not simulate
  deformable excavation, true crater depressions, or berm deposition.
-->
<sdf version="1.10">
  <world name="lunabotics_arena">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <!-- The physical competition takes place under Earth gravity. -->
    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.45 0.43 0.39 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="overhead_light" type="directional">
      <pose>3.44 2.50 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.1</intensity>
      <direction>-0.25 0.15 -0.96</direction>
      <diffuse>0.92 0.90 0.86 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>50</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- 45 cm static BP-1 surrogate; its top surface is z=0. -->
    <model name="bp1_regolith_bed">
      <static>true</static>
      <pose>3.44 2.50 -0.225 0 0 0</pose>
      <link name="regolith">
        <collision name="regolith_collision">
          <geometry><box><size>6.88 5.00 0.45</size></box></geometry>
          <surface>
            <!-- Tuning value only: the guidebook says BP-1 friction is unmeasured. -->
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="regolith_visual">
          <geometry><box><size>6.88 5.00 0.45</size></box></geometry>
          <material>
            <ambient>0.24 0.20 0.16 1</ambient>
            <diffuse>0.34 0.28 0.21 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
            <roughness>0.95</roughness>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only plan markings, 3-14 mm above grade. -->
    <model name="arena_markings">
      <static>true</static>
      <link name="markings">
        <!-- Excavation / obstacle-zone boundary at x=2.50 m. -->
        <visual name="excavation_boundary">
          <pose>2.50 2.50 0.003 0 0 0</pose>
          <geometry><box><size>0.025 5.00 0.006</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>

        <!-- Approximate construction-zone boundary shown in Figure 9. -->
        <visual name="construction_boundary">
          <pose>5.19 1.50 0.003 0 0 0</pose>
          <geometry><box><size>3.38 0.025 0.006</size></box></geometry>
          <material><ambient>0.25 0.65 1.0 1</ambient><diffuse>0.25 0.65 1.0 1</diffuse></material>
        </visual>

        <!-- Starting envelope inferred from the dimensioned Figure 9 outline. -->
        <visual name="starting_zone">
          <pose>1.00 0.75 0.004 0 0 0</pose>
          <geometry><box><size>2.00 1.50 0.008</size></box></geometry>
          <material><ambient>0.20 0.75 0.25 0.16</ambient><diffuse>0.20 0.75 0.25 0.16</diffuse></material>
          <transparency>0.84</transparency>
        </visual>

        <!-- Scored berm target: 2.20 x 0.90 m centered at (5.38, 0.90). -->
        <visual name="berm_target">
          <pose>5.38 0.90 0.006 0 0 0</pose>
          <geometry><box><size>2.20 0.90 0.012</size></box></geometry>
          <material><ambient>0.90 0.12 0.08 0.20</ambient><diffuse>0.90 0.12 0.08 0.20</diffuse></material>
          <transparency>0.80</transparency>
        </visual>
        <visual name="berm_center">
          <pose>5.38 0.90 0.014 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.10 0.95 0.25 1</ambient><diffuse>0.10 0.95 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arena walls; inner faces are on the 6.88 x 5.00 m boundary. -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="south_collision"><pose>3.44 -0.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry></collision>
        <visual name="south_visual"><pose>3.44 -0.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry><material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <collision name="north_collision"><pose>3.44 5.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry></collision>
        <visual name="north_visual"><pose>3.44 5.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry><material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <collision name="west_collision"><pose>-0.05 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry></collision>
        <visual name="west_visual"><pose>-0.05 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry><material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <collision name="east_collision"><pose>6.93 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry></collision>
        <visual name="east_visual"><pose>6.93 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry><material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 17 cm diameter PVC ducting along the inside perimeter. -->
    <model name="perimeter_ducts">
      <static>true</static>
      <link name="ducts">
        <collision name="south_collision"><pose>3.44 0.085 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry></collision>
        <visual name="south_visual"><pose>3.44 0.085 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
        <collision name="north_collision"><pose>3.44 4.915 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry></collision>
        <visual name="north_visual"><pose>3.44 4.915 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
        <collision name="west_collision"><pose>0.085 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry></collision>
        <visual name="west_visual"><pose>0.085 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
        <collision name="east_collision"><pose>6.795 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry></collision>
        <visual name="east_visual"><pose>6.795 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Permanent support column; size and exact pose are assumptions. -->
    <model name="central_support_column">
      <static>true</static><pose>3.44 2.50 1.25 0 0 0</pose>
      <link name="column">
        <collision name="collision"><geometry><box><size>0.45 0.45 2.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 2.50</size></box></geometry><material><ambient>0.70 0.12 0.10 1</ambient><diffuse>0.82 0.18 0.14 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Repeatable representative 30-40 cm boulders. -->
    <model name="boulder_obstacle_1"><static>true</static><pose>3.10 4.05 0.13 0 0 0</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.17</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.17</radius></sphere></geometry><material><ambient>0.28 0.25 0.22 1</ambient><diffuse>0.36 0.32 0.28 1</diffuse></material></visual></link></model>
    <model name="boulder_obstacle_2"><static>true</static><pose>5.75 3.75 0.15 0 0 0</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.20</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.25 0.23 0.20 1</ambient><diffuse>0.34 0.30 0.26 1</diffuse></material></visual></link></model>
    <model name="boulder_obstacle_3"><static>true</static><pose>4.75 2.05 0.13 0 0 0</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.30 0.27 0.23 1</ambient><diffuse>0.38 0.34 0.29 1</diffuse></material></visual></link></model>
    <model name="boulder_obstacle_4"><static>true</static><pose>6.15 2.65 0.12 0 0 0</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.16</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.16</radius></sphere></geometry><material><ambient>0.27 0.24 0.21 1</ambient><diffuse>0.35 0.31 0.27 1</diffuse></material></visual></link></model>

    <!-- Boulders are allowed in excavation, but never in the starting zone. -->
    <model name="boulder_excavation_1"><static>true</static><pose>0.65 3.70 0.13 0 0 0</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.17</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.17</radius></sphere></geometry><material><ambient>0.29 0.26 0.22 1</ambient><diffuse>0.37 0.33 0.28 1</diffuse></material></visual></link></model>
    <model name="boulder_excavation_2"><static>true</static><pose>1.85 2.75 0.14 0 0 0</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.19</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.19</radius></sphere></geometry><material><ambient>0.26 0.24 0.21 1</ambient><diffuse>0.35 0.31 0.27 1</diffuse></material></visual></link></model>

    <!-- Three 45 cm crater proxies in the obstacle zone. -->
    <model name="crater_obstacle_1">
      <static>true</static><pose>4.05 3.55 0.015 0 0 0</pose>
      <link name="crater"><collision name="collision"><geometry><cylinder><radius>0.225</radius><length>0.03</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.225</radius><length>0.03</length></cylinder></geometry><material><ambient>0.07 0.06 0.05 1</ambient><diffuse>0.10 0.08 0.06 1</diffuse></material></visual></link>
    </model>
    <model name="crater_obstacle_2">
      <static>true</static><pose>5.20 4.50 0.015 0 0 0</pose>
      <link name="crater"><collision name="collision"><geometry><cylinder><radius>0.225</radius><length>0.03</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.225</radius><length>0.03</length></cylinder></geometry><material><ambient>0.07 0.06 0.05 1</ambient><diffuse>0.10 0.08 0.06 1</diffuse></material></visual></link>
    </model>
    <model name="crater_obstacle_3">
      <static>true</static><pose>6.15 1.95 0.015 0 0 0</pose>
      <link name="crater"><collision name="collision"><geometry><cylinder><radius>0.225</radius><length>0.03</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.225</radius><length>0.03</length></cylinder></geometry><material><ambient>0.07 0.06 0.05 1</ambient><diffuse>0.10 0.08 0.06 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
