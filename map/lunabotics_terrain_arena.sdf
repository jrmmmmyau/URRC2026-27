<?xml version="1.0"?>
<!--
  NASA Lunabotics 2026-2027 arena with non-flat, collidable BP-1 terrain.

  Unlike lunabotics_arena.sdf, the regolith visual and collision geometries use
  the same heightmap. The three crater centers are actual depressions with
  raised rims, not flat disk models:
    (3.25, 3.80), radius 0.24 m, depth 0.28 m
    (4.55, 2.85), radius 0.25 m, depth 0.34 m
    (6.00, 3.70), radius 0.23 m, depth 0.30 m

  The starting zone, berm target, and perimeter are blended to nominal grade.
  The remaining surface contains deterministic low-frequency undulation.
  Regenerate the PNG with generate_lunabotics_heightmap.py.
-->
<sdf version="1.10">
  <world name="lunabotics_terrain_arena">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.36 0.35 0.33 1</ambient>
      <background>0.07 0.08 0.11 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="arena_lighting" type="directional">
      <pose>3.44 2.50 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.15</intensity>
      <direction>-0.35 0.18 -0.92</direction>
      <diffuse>0.90 0.88 0.83 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <attenuation><range>50</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic></attenuation>
    </light>

    <!--
      The PNG grayscale range maps to [-0.40 m, +0.15 m]. Relative resource
      paths keep the world relocatable when installed with the description package.
    -->
    <model name="bp1_heightmap_terrain">
      <static>true</static>
      <pose>3.44 2.50 0 0 0 0</pose>
      <link name="terrain">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>heightmaps/lunabotics_moon_terrain.png</uri>
              <size>6.88 5.00 0.55</size>
              <pos>0 0 -0.40</pos>
              <sampling>1</sampling>
            </heightmap>
          </geometry>
          <surface>
            <!-- Simulation tuning value; BP-1 friction is unmeasured. -->
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <uri>heightmaps/lunabotics_moon_terrain.png</uri>
              <size>6.88 5.00 0.55</size>
              <pos>0 0 -0.40</pos>
              <sampling>1</sampling>
            </heightmap>
          </geometry>
          <material>
            <ambient>0.24 0.21 0.18 1</ambient>
            <diffuse>0.36 0.31 0.25 1</diffuse>
            <specular>0.025 0.025 0.025 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Flat operational markers align with areas flattened in the heightmap. -->
    <model name="operational_markings">
      <static>true</static>
      <link name="markings">
        <visual name="starting_zone">
          <pose>1.00 0.75 0.006 0 0 0</pose>
          <geometry><box><size>2.00 1.50 0.012</size></box></geometry>
          <material><ambient>0.15 0.75 0.22 0.16</ambient><diffuse>0.15 0.75 0.22 0.16</diffuse></material>
          <transparency>0.84</transparency>
        </visual>
        <visual name="berm_target">
          <pose>5.38 0.90 0.008 0 0 0</pose>
          <geometry><box><size>2.20 0.90 0.016</size></box></geometry>
          <material><ambient>0.90 0.10 0.07 0.20</ambient><diffuse>0.90 0.10 0.07 0.20</diffuse></material>
          <transparency>0.80</transparency>
        </visual>
        <visual name="berm_center">
          <pose>5.38 0.90 0.020 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.08 0.95 0.22 1</ambient><diffuse>0.08 0.95 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls use the same documented 6.88 m x 5.00 m inner boundary. -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="south_collision"><pose>3.44 -0.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry></collision>
        <visual name="south_visual"><pose>3.44 -0.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry><material><ambient>0.48 0.50 0.53 1</ambient><diffuse>0.60 0.62 0.66 1</diffuse></material></visual>
        <collision name="north_collision"><pose>3.44 5.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry></collision>
        <visual name="north_visual"><pose>3.44 5.05 0.30 0 0 0</pose><geometry><box><size>6.98 0.10 0.60</size></box></geometry><material><ambient>0.48 0.50 0.53 1</ambient><diffuse>0.60 0.62 0.66 1</diffuse></material></visual>
        <collision name="west_collision"><pose>-0.05 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry></collision>
        <visual name="west_visual"><pose>-0.05 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry><material><ambient>0.48 0.50 0.53 1</ambient><diffuse>0.60 0.62 0.66 1</diffuse></material></visual>
        <collision name="east_collision"><pose>6.93 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry></collision>
        <visual name="east_visual"><pose>6.93 2.50 0.30 0 0 0</pose><geometry><box><size>0.10 5.00 0.60</size></box></geometry><material><ambient>0.48 0.50 0.53 1</ambient><diffuse>0.60 0.62 0.66 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 17 cm PVC ducting around the inner perimeter. -->
    <model name="perimeter_ducts">
      <static>true</static>
      <link name="ducts">
        <collision name="south_collision"><pose>3.44 0.085 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry></collision>
        <visual name="south_visual"><pose>3.44 0.085 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
        <collision name="north_collision"><pose>3.44 4.915 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry></collision>
        <visual name="north_visual"><pose>3.44 4.915 0.085 0 1.570796 0</pose><geometry><cylinder><radius>0.085</radius><length>6.71</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
        <collision name="west_collision"><pose>0.085 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry></collision>
        <visual name="west_visual"><pose>0.085 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
        <collision name="east_collision"><pose>6.795 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry></collision>
        <visual name="east_visual"><pose>6.795 2.50 0.085 1.570796 0 0</pose><geometry><cylinder><radius>0.085</radius><length>4.66</length></cylinder></geometry><material><ambient>0.78 0.78 0.75 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material></visual>
      </link>
    </model>

    <model name="central_support_column">
      <static>true</static><pose>3.44 2.50 1.25 0 0 0</pose>
      <link name="column">
        <collision name="collision"><geometry><box><size>0.45 0.45 2.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 2.50</size></box></geometry><material><ambient>0.70 0.12 0.10 1</ambient><diffuse>0.82 0.18 0.14 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Irregular low-poly mesh rocks; diameters remain in the 30-40 cm range. -->
    <!-- Visual meshes use simple box collisions to avoid DART / ODE custom-mesh crashes. -->
    <model name="rock_obstacle_1"><static>true</static><pose>3.05 4.48 0.02 0.08 -0.05 0.45</pose><link name="rock"><collision name="collision"><pose>0 0 0.058 0 0 0</pose><geometry><box><size>0.34 0.27 0.17</size></box></geometry></collision><visual name="visual"><geometry><mesh><uri>meshes/lunar_rock.obj</uri><scale>0.21 0.18 0.18</scale></mesh></geometry><material><ambient>0.25 0.23 0.20 1</ambient><diffuse>0.34 0.31 0.27 1</diffuse></material></visual></link></model>
    <model name="rock_obstacle_2"><static>true</static><pose>3.95 2.05 0.02 -0.06 0.04 1.20</pose><link name="rock"><collision name="collision"><pose>0 0 0.052 0 0 0</pose><geometry><box><size>0.29 0.30 0.15</size></box></geometry></collision><visual name="visual"><geometry><mesh><uri>meshes/lunar_rock.obj</uri><scale>0.18 0.20 0.16</scale></mesh></geometry><material><ambient>0.28 0.25 0.21 1</ambient><diffuse>0.37 0.33 0.28 1</diffuse></material></visual></link></model>
    <model name="rock_obstacle_3"><static>true</static><pose>5.35 4.30 0.02 0.04 0.07 2.10</pose><link name="rock"><collision name="collision"><pose>0 0 0.061 0 0 0</pose><geometry><box><size>0.32 0.25 0.18</size></box></geometry></collision><visual name="visual"><geometry><mesh><uri>meshes/lunar_rock.obj</uri><scale>0.20 0.17 0.19</scale></mesh></geometry><material><ambient>0.26 0.24 0.21 1</ambient><diffuse>0.35 0.32 0.28 1</diffuse></material></visual></link></model>
    <model name="rock_obstacle_4"><static>true</static><pose>6.25 2.20 0.02 -0.05 -0.04 0.85</pose><link name="rock"><collision name="collision"><pose>0 0 0.055 0 0 0</pose><geometry><box><size>0.28 0.31 0.16</size></box></geometry></collision><visual name="visual"><geometry><mesh><uri>meshes/lunar_rock.obj</uri><scale>0.17 0.21 0.17</scale></mesh></geometry><material><ambient>0.27 0.24 0.20 1</ambient><diffuse>0.36 0.32 0.27 1</diffuse></material></visual></link></model>
    <model name="rock_excavation_1"><static>true</static><pose>0.70 3.70 0.02 0.03 -0.06 1.60</pose><link name="rock"><collision name="collision"><pose>0 0 0.058 0 0 0</pose><geometry><box><size>0.31 0.25 0.17</size></box></geometry></collision><visual name="visual"><geometry><mesh><uri>meshes/lunar_rock.obj</uri><scale>0.19 0.17 0.18</scale></mesh></geometry><material><ambient>0.26 0.23 0.20 1</ambient><diffuse>0.35 0.31 0.27 1</diffuse></material></visual></link></model>
    <model name="rock_excavation_2"><static>true</static><pose>1.82 2.70 0.02 -0.04 0.05 2.65</pose><link name="rock"><collision name="collision"><pose>0 0 0.052 0 0 0</pose><geometry><box><size>0.32 0.28 0.15</size></box></geometry></collision><visual name="visual"><geometry><mesh><uri>meshes/lunar_rock.obj</uri><scale>0.20 0.19 0.16</scale></mesh></geometry><material><ambient>0.28 0.25 0.21 1</ambient><diffuse>0.37 0.33 0.28 1</diffuse></material></visual></link></model>
  </world>
</sdf>
