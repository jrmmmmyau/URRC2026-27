<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.10">
  <world name="lunabotics_arena">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
    <!-- The physical competition takes place under Earth gravity. -->
    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.45 0.43 0.39 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="overhead_light" type="directional">
      <pose>3.44 2.50 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.1</intensity>
      <direction>-0.25 0.15 -0.96</direction>
      <diffuse>0.92 0.90 0.86 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>50</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <!-- 45 cm static BP-1 surrogate; its top surface is z=0. -->
    <model name="bp1_regolith_bed">
      <static>true</static>
      <pose>3.44 2.50 -0.225 0 0 0</pose>
      <link name="regolith">
        <collision name="regolith_collision">
          <geometry>
            <box>
              <size>6.88 5.00 0.45</size>
            </box>
          </geometry>
          <surface>
            <!-- Tuning value only: the guidebook says BP-1 friction is unmeasured. -->
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="regolith_visual">
          <geometry>
            <box>
              <size>6.88 5.00 0.45</size>
            </box>
          </geometry>
          <material>
            <ambient>0.24 0.20 0.16 1</ambient>
            <diffuse>0.34 0.28 0.21 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
            <roughness>0.95</roughness>
          </material>
        </visual>
      </link>
    </model>
    <!-- Visual-only plan markings, 3-14 mm above grade. -->
    <model name="arena_markings">
      <static>true</static>
      <link name="markings">
        <!-- Excavation / obstacle-zone boundary at x=2.50 m. -->
        <visual name="excavation_boundary">
          <pose>2.50 2.50 0.003 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 5.00 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <!-- Approximate construction-zone boundary shown in Figure 9. -->
