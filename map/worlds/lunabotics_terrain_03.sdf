<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.10">
  <world name="lunabotics_terrain_arena">
    <!-- Variant 3: Diagonal Ridge; broad grades <= 15 degrees -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.36 0.35 0.33 1</ambient>
      <background>0.07 0.08 0.11 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="arena_lighting" type="directional">
      <pose>3.44 2.50 8 0 0 0</pose>
      <visualize>false</visualize>
      <cast_shadows>true</cast_shadows>
      <intensity>1.15</intensity>
      <direction>-0.35 0.18 -0.92</direction>
      <diffuse>0.90 0.88 0.83 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <attenuation>
        <range>50</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <!--
      The PNG encodes the [-0.40 m, +0.45 m] design range into Gazebo's
      [0.00 m, 0.85 m] heightfield range. Nominal grade is z=0.40 m.
      Relative paths keep the installed world relocatable.
    -->
    <model name="bp1_heightmap_terrain">
      <static>true</static>
      <pose>3.44 2.50 0 0 0 0</pose>
      <link name="terrain">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>../assets/terrain_03/heightmap.png</uri>
              <size>6.88 5.00 0.85</size>
              <sampling>1</sampling>
            </heightmap>
          </geometry>
          <surface>
            <!-- Simulation tuning value; BP-1 friction is unmeasured. -->
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <!-- A mesh avoids Ogre 1's black heightmap-material rendering bug. -->
        <visual name="terrain_visual">
          <geometry>
            <mesh>
              <uri>../assets/terrain_03/terrain.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.34 0.31 0.27 1</ambient>
            <diffuse>0.48 0.44 0.38 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!--
      High-contrast visual-only zone markings follow Figure 9 of the guidebook.
      Blue: excavation, amber: obstacle, magenta: construction, green: start,
      and red: the official 2.2 m x 0.9 m berm scoring box.
    -->
    <model name="zone_markings">
      <static>true</static>
      <link name="markings">
        <!-- Starting zone, inset from the pipe so all four sides stay visible. -->
