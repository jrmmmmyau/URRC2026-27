<?xml version="1.0"?>
<robot name="deposition_robot">

  <!-- =========================
       Global materials
       ========================= -->
  <material name="gray">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.20 0.45 0.85 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.95 0.50 0.15 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>


  <!-- =========================
       BASE
       x = forward
       y = left
       z = up
       ========================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.75 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.75 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="68.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="3.196" ixy="0.0" ixz="0.0" iyy="3.196" iyz="0.0" izz="6.38"/>
    </inertial>
  </link>


  <!-- =========================
       DEPOSITION SYSTEM
       Rear half of robot
       ========================= -->
  <link name="deposition_system_link">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.32 0.163"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.32 0.163"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.44"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.053" ixy="0.0" ixz="0.0" iyy="0.045" iyz="0.0" izz="0.112"/>
    </inertial>
  </link>

  <joint name="base_to_deposition_joint" type="fixed">
    <parent link="base_link"/>
    <child link="deposition_system_link"/>
    <!-- rear = negative x -->
    <origin xyz="-0.22 0 0.075" rpy="0 0 0"/>
  </joint>


  <!-- =========================
       EXTRACTION SYSTEM
       Front half, taller than deposition system
       ========================= -->
  <link name="extraction_system_link">
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.30 0.34"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.30 0.34"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="19.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.236" ixy="0.0" ixz="0.0" iyy="0.937" iyz="0.0" izz="0.714"/>
    </inertial>
  </link>

  <joint name="base_to_extraction_joint" type="fixed">
    <parent link="base_link"/>
    <child link="extraction_system_link"/>
    <!-- front = positive x -->
    <origin xyz="0.22 0 0.075" rpy="0 0 0"/>
  </joint>


  <!-- =========================================================
       FRONT LEFT WHEEL MODULE
       base -> steering joint -> vertical rod -> wheel spin joint -> wheel
       ========================================================= -->
  <link name="front_left_steering_rod_link">
    <visual>
      <!-- rod extends downward from its link frame -->
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_rod_link"/>
    <origin xyz="0.32 0.24 -0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_spin_joint" type="continuous">
    <parent link="front_left_steering_rod_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- =========================================================
       FRONT RIGHT WHEEL MODULE
       ========================================================= -->
  <link name="front_right_steering_rod_link">
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_rod_link"/>
    <origin xyz="0.32 -0.24 -0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_spin_joint" type="continuous">
    <parent link="front_right_steering_rod_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- =========================================================
       REAR LEFT WHEEL MODULE
       ========================================================= -->
  <link name="rear_left_steering_rod_link">
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="rear_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_left_steering_rod_link"/>
    <origin xyz="-0.32 0.24 -0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_spin_joint" type="continuous">
    <parent link="rear_left_steering_rod_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- =========================================================
       REAR RIGHT WHEEL MODULE
       ========================================================= -->
  <link name="rear_right_steering_rod_link">
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="rear_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_right_steering_rod_link"/>
    <origin xyz="-0.32 -0.24 -0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_spin_joint" type="continuous">
    <parent link="rear_right_steering_rod_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
