
<sdf version='1.10'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Ground -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Enclosure walls -->
    <model name='north_wall'>
      <pose>0 2.5 0.5 0 0 0</pose>
      <static>true</static>
      <link name='north_wall'>
        <pose>0 0 0 0 0 0</pose>
        <collision name='box_collision'>
          <geometry><box><size>4.3 0.2 1</size></box></geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/><contact/>
          </surface>
        </collision>
        <visual name='north_wall'>
          <geometry><box><size>4.3 0.2 1</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
    </model>

    <model name='south_wall'>
      <pose>0 -2.5 0.5 0 0 0</pose>
      <static>true</static>
      <link name='south_wall'>
        <pose>0 0 0 0 0 0</pose>
        <collision name='box_collision'>
          <geometry><box><size>4.3 0.2 1</size></box></geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/><contact/>
          </surface>
        </collision>
        <visual name='box_visual'>
          <geometry><box><size>4.3 0.2 1</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
    </model>

    <model name='east_wall'>
      <pose>2.15 0 0.5 0 0 0</pose>
      <static>true</static>
      <link name='east_wall'>
        <pose>0 0 0 0 0 0</pose>
        <collision name='box_collision'>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/><contact/>
          </surface>
        </collision>
        <visual name='east_wall'>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
    </model>

    <model name='west_wall'>
      <pose>-2.15 0 0.5 0 0 0</pose>
      <static>true</static>
      <link name='west_wall'>
        <pose>0 0 0 0 0 0</pose>
        <collision name='box_collision'>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/><contact/>
          </surface>
        </collision>
        <visual name='west_wall'>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
    </model>

    <!-- Obstacles -->
    <model name='sphere_1'>
      <pose>1 -1 0 0 0 0</pose>
      <static>true</static>
      <link name='sphere_link'>
        <pose>0 0 0 0 0 0</pose>
        <collision name='sphere_collision'>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/><contact/>
          </surface>
        </collision>
        <visual name='sphere_visual'>
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
    </model>

    <model name='sphere_2'>
      <pose>-1 1 0 0 0 0</pose>
      <static>true</static>
      <link name='sphere_link'>
        <pose>0 0 0 0 0 0</pose>
        <collision name='sphere_collision'>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/><contact/>
          </surface>
        </collision>
        <visual name='sphere_visual'>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
    </model>

    <model name='cylinder'>
      <pose>0.5 0.5 0.25 0 0 0</pose>
      <static>true</static>

      <link name='cylinder_link'>
        <pose>0 0 0 0 0 0</pose>

        <collision name='cylinder_collision'>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name='bump_visual'>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.3 0.1 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Lighting -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
