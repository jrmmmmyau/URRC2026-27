<?xml version="1.0"?>
<robot name="melbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================
       Global materials
       ========================= -->
  <material name="gray">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.20 0.45 0.85 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.95 0.50 0.15 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>


  <!-- =========================
       BASE
       x = forward
       y = left
       z = up
       ========================= -->


<link name="base_link"/>

<joint name="chassis_joint" type="fixed">
  <parent link="base_link"/>
  <child link="chassis"/>
  <origin xyz="0 0 0.31" rpy="0 0 0"/>
</joint>
<link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.75 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.75 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="68.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="3.196" ixy="0.0" ixz="0.0" iyy="3.196" iyz="0.0" izz="6.38"/>
    </inertial>
  </link>


  <!-- =========================
       DEPOSITION SYSTEM
       Rear half of robot
       ========================= -->
  <link name="deposition_system_link">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.32 0.163"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.32 0.163"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.44"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.053" ixy="0.0" ixz="0.0" iyy="0.045" iyz="0.0" izz="0.112"/>
    </inertial>
  </link>

  <joint name="base_to_deposition_joint" type="fixed">
    <parent link="chassis"/>
    <child link="deposition_system_link"/>
    <!-- rear = negative x -->
    <origin xyz="-0.22 0 0.0" rpy="0 0 0"/>
  </joint>


  <!-- =========================
       EXTRACTION SYSTEM
       Front half, taller than deposition system
       ========================= -->
  <link name="extraction_system_link">
    <visual>
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.34"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.34"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="19.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.326" ixy="0.0" ixz="0.0" iyy="0.937" iyz="0.0" izz="0.714"/>
    </inertial>
  </link>

  <joint name="base_to_extraction_joint" type="fixed">
    <parent link="chassis"/>
    <child link="extraction_system_link"/>
    <!-- front = positive x -->
    <origin xyz="0.175 0 0.0" rpy="0 0 0"/>
  </joint>


  <!-- =========================================================
       FRONT LEFT WHEEL MODULE
       base -> steering joint -> vertical rod -> wheel spin joint -> wheel
       ========================================================= -->
  <link name="front_left_steering_rod_link">
    <visual>
      <!-- rod extends downward from its link frame -->
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="chassis"/>
    <child link="front_left_steering_rod_link"/>
    <origin xyz="0.32 0.24 -0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="100.0" velocity="2.0"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_spin_joint" type="continuous">
    <parent link="front_left_steering_rod_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- =========================================================
       FRONT RIGHT WHEEL MODULE
       ========================================================= -->
  <link name="front_right_steering_rod_link">
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="chassis"/>
    <child link="front_right_steering_rod_link"/>
    <origin xyz="0.32 -0.24 -0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="100.0" velocity="2.0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_spin_joint" type="continuous">
    <parent link="front_right_steering_rod_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- =========================================================
       REAR LEFT WHEEL MODULE
       ========================================================= -->
  <link name="rear_left_steering_rod_link">
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="rear_left_steering_joint" type="revolute">
    <parent link="chassis"/>
    <child link="rear_left_steering_rod_link"/>
    <origin xyz="-0.32 0.24 -0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_spin_joint" type="continuous">
    <parent link="rear_left_steering_rod_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- =========================================================
       REAR RIGHT WHEEL MODULE
       ========================================================= -->
  <link name="rear_right_steering_rod_link">
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.22"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="rear_right_steering_joint" type="revolute">
    <parent link="chassis"/>
    <child link="rear_right_steering_rod_link"/>
    <origin xyz="-0.32 -0.24 -0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <!-- cylinder is rotated so wheel axle is along y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.54"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.00557" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_spin_joint" type="continuous">
    <parent link="rear_right_steering_rod_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
 <!-- =========================================================
       IMU MODULE (invisible)
       ========================================================= -->
  <link name="imu_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

 <!-- =========================================================
       camera combination
       ========================================================= -->
  <xacro:include filename="camera.xacro"/>

  <xacro:realsense name="front_camera" parent="chassis">
    <origin xyz="0.36 0 0.39" rpy="0 ${pi/4} 0"/>
  </xacro:realsense>

  <link name="top_camera_holder_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1.6e-4"/>
    </inertial>
  </link>

  <joint name="top_camera_holder_joint" type="continuous">
    <parent link="chassis"/>
    <child link="top_camera_holder_link"/>
    <origin xyz="0.36 0 0.45" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1"/>
  </joint>

  <xacro:realsense name="top_camera" parent="top_camera_holder_link">
    <origin xyz="0.03 0 0.04" rpy="0 0 0"/>
  </xacro:realsense>

 <!-- =========================================================
gazebo plug in for joints

       ========================================================= -->
<gazebo>  <!--plugin from gazebo package built in, joint attach, topic to subscribe to, pid-p gain-->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steering_joint</joint_name>
      <topic>/cmd_pos/fl_steering</topic>
      <p_gain>100.0</p_gain>
      <i_gain>60.0</i_gain>
      <!-- <d_gain>5.0</d_gain> -->
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steering_joint</joint_name>
      <topic>/cmd_pos/fr_steering</topic>
      <p_gain>100.0</p_gain>
      <i_gain>60.0</i_gain>
      <!-- <d_gain>5.0</d_gain> -->
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rear_left_steering_joint</joint_name>
      <topic>/cmd_pos/rl_steering</topic>
      <p_gain>100.0</p_gain>
      <i_gain>60.0</i_gain>
      <!-- <d_gain>5.0</d_gain> -->
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rear_right_steering_joint</joint_name>
      <topic>/cmd_pos/rr_steering</topic>
      <p_gain>100.0</p_gain>
      <i_gain>60.0</i_gain>
      <d_gain>5.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>front_left_wheel_spin_joint</joint_name>
      <topic>/cmd_vel/fl_wheel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>front_right_wheel_spin_joint</joint_name>
      <topic>/cmd_vel/fr_wheel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_spin_joint</joint_name>
      <topic>/cmd_vel/rl_wheel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_spin_joint</joint_name>
      <topic>/cmd_vel/rr_wheel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>top_camera_holder_joint</joint_name>
      <topic>/cmd_vel/camera</topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_steering_joint</joint_name>
      <joint_name>front_right_steering_joint</joint_name>
      <joint_name>rear_left_steering_joint</joint_name>
      <joint_name>rear_right_steering_joint</joint_name>
      <joint_name>front_left_wheel_spin_joint</joint_name>
      <joint_name>front_right_wheel_spin_joint</joint_name>
      <joint_name>rear_left_wheel_spin_joint</joint_name>
      <joint_name>rear_right_wheel_spin_joint</joint_name>
      <joint_name>top_camera_holder_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
</robot>
