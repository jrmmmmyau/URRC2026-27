<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="realsense" params="name parent *origin">

    <link name="${name}_link">
        <visual>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
        <collision>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        </collision>
        <inertial>
        <mass value="0.072"/>
        <inertia ixx="5e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="5e-5"/>
        </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${name}_link"/>
        <xacro:insert_block name="origin"/>
    </joint>

    <link name="${name}_optical_link"/>
    <joint name="${name}_optical_joint" type="fixed">
        <parent link="${name}_link"/>
        <child link="${name}_optical_link"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="${name}_link">
        <sensor name="${name}" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>${name}</topic>
        <gz_frame_id>${name}_optical_link</gz_frame_id>
        <camera>
            <horizontal_fov>1.21</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>10.0</far></clip></depth_camera>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
        </sensor>
    </gazebo>
    </xacro:macro>

</robot>
